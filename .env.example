# ============================================================
# Job Search Agent — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# --- Resume ---
RESUME_PATH=./resume.pdf
# Alternatively, supply a base64-encoded PDF for CI/CD:
# RESUME_BASE64=

# --- Database ---
# Matches the Docker container in docker-compose.yml (Postgres on port 5433).
DATABASE_URL=postgresql://jobagent:jobagent123@localhost:5433/job_search_agent

# --- Claude API ---
CLAUDE_API_KEY=sk-ant-...
# Any Claude model ID — use a smaller/faster model to reduce cost.
CLAUDE_MODEL=claude-opus-4-7
CLAUDE_MAX_TOKENS=4096
# Submit a day's jobs via the Anthropic Batch API for lower cost (true/false).
USE_BATCH_API=false

# --- Email digest (Mailgun) ---
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=your-domain.mailgun.org
# US region: https://api.mailgun.net  |  EU region: https://api.eu.mailgun.net
MAILGUN_BASE_URL=https://api.mailgun.net
RECIPIENT_EMAIL=your-email@example.com

# --- Job APIs ---
# RapidAPI key with a JSearch subscription:
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=your_rapidapi_key

# --- Agent Behaviour ---
NODE_ENV=development
JOB_TITLES=Senior Software Engineer,Staff Software Engineer
LOCATION_PRIORITY=remote,washington,other

# Free-text context injected into every Claude prompt, e.g.
# "I'm looking to move into platform/infrastructure roles."
USER_CONTEXT=

# Location categorization keywords (comma-separated, case-insensitive substring match)
LOCATION_KEYWORDS_REMOTE=remote
LOCATION_KEYWORDS_WASHINGTON=seattle,bellevue,tacoma,redmond,renton,kirkland,sammamish,auburn,kent,des moines,washington,- wa
LOCATION_KEYWORDS_OTHER=
YEARS_EXPERIENCE=7
PREFERRED_COMPANY_STAGE=scale-up,enterprise
EXCLUDE_KEYWORDS=
PREFERRED_TECHNICAL_STACK=Java,Spring Boot,Kafka,Elasticsearch,PostgreSQL,Docker

# --- Schedule ---
# Used by the cron wrapper scripts in scripts/ (run-agent.sh, run-digest.sh).
JOB_FETCH_TIME=08:00
JOB_FETCH_TIMEZONE=America/Los_Angeles
WEEKLY_DIGEST_DAY=sunday
WEEKLY_DIGEST_TIME=18:00
WEEKLY_DIGEST_TIMEZONE=America/Los_Angeles

# --- PII Redaction ---
ENABLE_PII_REDACTION=true
ADDITIONAL_REDACTION_PATTERNS=

# --- Learning ---
AGENT_MEMORY_RETENTION_DAYS=90
ENABLE_PATTERN_LEARNING=true
PATTERN_CONFIDENCE_THRESHOLD=0.5
